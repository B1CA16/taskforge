# Copy to .env and adjust. TaskForge reads TASKFORGE_DATABASE_URL, then DATABASE_URL.
# Uses psycopg 3 (the `psycopg` driver), which is installed with TaskForge.
TASKFORGE_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5435/postgres

# Optional
# DEFAULT_MAX_ATTEMPTS=3
# TASKFORGE_METRICS_PORT=9464

# The test suite never reads the variables above. It uses this instead (default shown),
# and refuses to run unless the database name contains "test":
# TASKFORGE_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5436/taskforge_test
