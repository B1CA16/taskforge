# https://editorconfig.org — conventions: docs/contributing/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json,jsonc,toml,html,css,js}]
indent_size = 2

[*.md]
# Two trailing spaces can be a deliberate line break in Markdown; we don't use them, but don't strip silently.
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf
